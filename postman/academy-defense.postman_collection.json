                "verify-email?token={{verificationToken}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"User is verified\", function () { pm.expect(pm.response.json().user.is_verified).to.eql(true); });"
