{
  "name": "server",
  "version": "1.0.0",
  "description": "Academy Portal backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "lint": "node scripts/lint.js",
    "pretest": "npm run prisma:generate",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "seed:admin": "node ./scripts/seed-admin.js",
    "seed:demo": "node ./scripts/reset-demo-data.js",
    "email:test": "node ./scripts/send-test-email.js",
    "predefense:check": "node ./scripts/predefense-check.js",
    "predefense:strict": "node ./scripts/predefense-check.js --strict"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "swagger-ui-express": "^5.0.1",
    "valibot": "^1.3.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13"
  }
}
