ENVIRONMENT=development
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=5173

DATABASE_URL=postgresql://postgres:1234@localhost:5432/academy_db
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
PUBLIC_APP_URL=http://localhost:5173

EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=Academy Portal <no-reply@example.com>
EMAIL_API_KEY=
EMAIL_LOG_PATH=email.out.log
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

ENABLE_BACKGROUND_WORKERS=false
START_WORKERS_IN_API=true
ENABLE_DAILY_STATS_JOB=true
EMAIL_QUEUE_NAME=academy-email
MAINTENANCE_QUEUE_NAME=academy-maintenance
STATS_JOB_REPEAT_MS=900000
ADMIN_NOTIFICATION_EMAILS=

ADMIN_EMAIL=admin@academy.dev
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Academy Admin
