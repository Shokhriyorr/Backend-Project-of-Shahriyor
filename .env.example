# Copy this file to .env for local Docker Compose.
# For production, keep the variable names and replace all secrets/URLs in the
# DeployRocks or Render environment dashboard.

ENVIRONMENT=development
NODE_ENV=development

POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=8080

DATABASE_URL=postgresql://postgres:postgres@db:5432/academy_db
REDIS_URL=redis://redis:6379

JWT_SECRET_KEY=local-access-secret-change-for-production-32chars
JWT_REFRESH_SECRET_KEY=local-refresh-secret-change-for-production-32chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Local development can use EMAIL_PROVIDER=log. Production must use smtp and
# must provide a real EMAIL_API_KEY or SMTP_PASS from SendGrid/Mailgun/etc.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=Academy Portal <no-reply@localhost>
EMAIL_API_KEY=
EMAIL_LOG_PATH=email.out.log
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_SECURE=false

ENABLE_BACKGROUND_WORKERS=true
START_WORKERS_IN_API=false
ENABLE_DAILY_STATS_JOB=true
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_QUEUE_NAME=academy-email
MAINTENANCE_QUEUE_NAME=academy-maintenance
STATS_JOB_REPEAT_MS=900000
ADMIN_NOTIFICATION_EMAILS=

ADMIN_EMAIL=admin@academy.dev
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Academy Admin
