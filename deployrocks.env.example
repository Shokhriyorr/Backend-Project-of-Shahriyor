# Paste into DeployRocks Environment (dashboard).
# Do NOT commit real secrets. DATABASE_URL is usually auto-injected.
# Link platform Redis (or paste Upstash URL) before enabling workers.

ENVIRONMENT=production
NODE_ENV=production

EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
STATS_JOB_REPEAT_MS=900000
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

START_WORKERS_IN_API=true
ENABLE_BACKGROUND_WORKERS=true
ENABLE_DAILY_STATS_JOB=true
EMAIL_PROVIDER=smtp

JWT_SECRET_KEY=replace-with-40-char-access-secret-abc123xyz
JWT_REFRESH_SECRET_KEY=replace-with-40-char-refresh-secret-xyz789abc

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.replace-with-sendgrid-api-key
EMAIL_FROM_ADDRESS=Academy Portal <your-verified-email@gmail.com>

PUBLIC_APP_URL=https://shokhriyorr-backend-project-of-shahriyor.kazi.rocks
CORS_ORIGINS=https://shokhriyorr-backend-project-of-shahriyor.kazi.rocks

ADMIN_NOTIFICATION_EMAILS=your-email@gmail.com
ADMIN_EMAIL=admin@academy.dev
ADMIN_PASSWORD=AdminPass123!
ADMIN_NAME=Academy Admin
